{
  "name": "meow-open-flight-core",
  "version": "0.1.0",
  "description": "MeowOpenFlightCore — aviation datasets, live aircraft sources, poller/SSE and Hono API for flight tracking.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./coords": {
      "types": "./dist/coords/index.d.ts",
      "import": "./dist/coords/index.js"
    },
    "./coords/mapcode-official": {
      "types": "./dist/coords/mapcode-official.d.ts",
      "import": "./dist/coords/mapcode-official.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "NOTICE.md",
    "DATA-LICENSES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup:data": "node scripts/setup-data.mjs",
    "import:airports": "node scripts/import-airports.mjs",
    "import:rpp": "node scripts/import-reporting-points.mjs",
    "import:fir": "node scripts/import-fir.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "prepack": "npm run build && npm run verify:data"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@types/geojson": "^7946.0.14",
    "cheerio": "^1.2.0",
    "hono": "^4.6.14",
    "lru-cache": "^11.0.2",
    "meow-tile-kit-core": "^1.0.0"
  },
  "peerDependencies": {
    "mapcode-ts": "^1.0.3",
    "playwright-core": "^1.49.0"
  },
  "peerDependenciesMeta": {
    "mapcode-ts": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "mapcode-ts": "^1.0.3",
    "playwright-core": "^1.49.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoslynMeow/MeowOpenFlightRadar.git",
    "directory": "packages/core"
  },
  "keywords": [
    "aviation",
    "airports",
    "runways",
    "navaids",
    "fir",
    "flight-tracking",
    "adsb",
    "hono"
  ],
  "license": "MIT"
}
