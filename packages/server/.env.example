# 服务端口
PORT=8787

# 飞机数据源: flightaware | flightradar24
AIRCRAFT_PROVIDER=flightradar24

# 后台轮询间隔（毫秒）。FlightAware 走无头浏览器抓取，间隔别太小以免被 Cloudflare 盯上。
POLL_INTERVAL_MS=2000

# FlightRadar24（可选）：不填则用免费网页接口（只返回部分飞机）；
# 填官方 API token 后改用 /api/live/flight-positions/full，数据完整但消耗 credits。
# FR24_API_TOKEN=

# 上游结果缓存（毫秒）
CACHE_TTL_MS=4000

# FlightAware 抓取（实验性，无需 key）：用 Playwright 无头浏览器过 Cloudflare 盾并读取
# VICINITY_TOKEN，再在页面内 fetch /ajax/vicinity_aircraft.rvt 拿 bbox 内飞机的 GeoJSON。
# 使用前需安装浏览器内核：npm run install:chromium
# 非官方、可能违反其服务条款，仅供本地试用；被挑战/限流时会自动重过盾或退避。

# CORS 允许来源，开发可保持 *
WEB_ORIGIN=*

# NOTAM 源（SkyLink API，可选）：https://skylinkapi.com/ 注册后在 dashboard 生成 key。
# 按机场 ICAO 查全球 NOTAM；不配置则点击扇区提示「尚未接入」。
# SKYLINK_API_KEY=

